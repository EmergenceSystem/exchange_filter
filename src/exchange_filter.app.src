{application, exchange_filter, [
    {description, "em_filter agent for currency exchange rates"},
    {vsn, "0.2.0"},
    {registered, [exchange_filter_sup, exchange_filter_server]},
    {mod, {exchange_filter_app, []}},
    {applications, [kernel, stdlib, cowboy,
        em_filter]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        exchange_filter_sup,
        exchange_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/exchange_filter"}]}
]}.
